{
  "name": "astro-template26",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "tsc -b",
    "lint": "biome lint . && stylelint \"**/*.{css,scss}\"",
    "lint:biome": "biome lint .",
    "lint:stylelint": "stylelint \"**/*.{css,scss}\"",
    "format": "biome format --write .",
    "check": "biome check --write . && stylelint --fix \"**/*.{css,scss}\"",
    "ci": "biome ci . && stylelint \"**/*.{css,scss}\""
  },
  "dependencies": {
    "astro": "^5.17.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "lefthook": "^2.1.1",
    "stylelint": "^17.3.0",
    "stylelint-config-recommended-scss": "^17.0.0"
  }
}
